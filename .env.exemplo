# Copie este arquivo para ".env" (sem .exemplo) e preencha.
ANTHROPIC_API_KEY=coloque-sua-chave-aqui

# Supabase do SGP (central-pessoal-adapta) — registro de candidaturas e banco de respostas.
# SUPABASE_SERVICE_ROLE_KEY bypassa RLS: nunca comite, nunca cole em chat.
SUPABASE_URL=coloque-a-url-do-projeto-aqui
SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key-aqui
SUPABASE_USER_ID=coloque-seu-user-id-aqui
